// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"  
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Tên danh mục không được trùng nhau
  description String?
  // Một Category có mảng nhiều Plant
  plants      Plant[]  
}

model Plant {
  id                  Int       @id @default(autoincrement())
  name                String
  price               Int
  wateringInstruction String?
  
  // Khóa ngoại (Foreign Key) liên kết sang bảng Category
  categoryId          Int?      
  category            Category? @relation(fields: [categoryId], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}